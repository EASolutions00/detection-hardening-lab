#!/bin/bash
# TeLoS archive helper for SIEM-01.
#
# Runs as root through ONE narrow sudoers rule:
#     eli ALL=(root) NOPASSWD: /usr/local/sbin/telos-archive
#
# Design rules:
#   1. Fixed subcommands only. No pass-through of arbitrary arguments.
#   2. Search patterns are read from a FILE, never taken on the command line.
#      sudo writes every command line to journald, Wazuh collects journald, so a
#      pattern on the command line creates a new event containing that pattern
#      and inflates its own count. See docs/OPEN-QUESTIONS.md item 1b.
#   3. Must be owned by root and not writable by eli, or the sudoers rule
#      becomes a path to full root.

set -u

ARCHIVE_DIR=/var/ossec/logs/archives
ARCHIVE="$ARCHIVE_DIR/archives.json"

usage() {
    echo "usage: telos-archive {size|list|tail N|count FILE|show FILE N|rotate|truncate}"
    echo "  size        bytes and path of archives.json"
    echo "  list        directory listing of the archives folder"
    echo "  tail N      last N lines of archives.json"
    echo "  count FILE  count lines matching the fixed strings in FILE"
    echo "  show FILE N first N lines matching the fixed strings in FILE"
    echo "  rotate      copy and gzip archives.json to /tmp, print the path"
    echo "  truncate    empty archives.json in place"
    exit 2
}

is_number() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

case "${1:-}" in
    size)
        if [ -f "$ARCHIVE" ]; then
            stat -c '%s bytes  %n' "$ARCHIVE"
        else
            echo "0 bytes  $ARCHIVE (does not exist)"
        fi
        ;;

    list)
        ls -l "$ARCHIVE_DIR"
        ;;

    tail)
        n="${2:-20}"
        is_number "$n" || usage
        tail -n "$n" "$ARCHIVE"
        ;;

    count)
        f="${2:-}"
        [ -f "$f" ] || { echo "count: pattern file not found: $f" >&2; exit 2; }
        grep -c -F -f "$f" "$ARCHIVE" || true
        ;;

    show)
        f="${2:-}"
        n="${3:-5}"
        [ -f "$f" ] || { echo "show: pattern file not found: $f" >&2; exit 2; }
        is_number "$n" || usage
        grep -F -f "$f" "$ARCHIVE" | head -n "$n" || true
        ;;

    rotate)
        ts=$(date -u +%Y%m%dT%H%M%SZ)
        out="/tmp/archives-$ts.json"
        cp "$ARCHIVE" "$out"
        gzip -f "$out"
        chmod 644 "$out.gz"
        echo "$out.gz"
        ;;

    truncate)
        truncate -s 0 "$ARCHIVE"
        echo "truncated $ARCHIVE"
        ;;

    *)
        usage
        ;;
esac
